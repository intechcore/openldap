{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned Symas OpenLDAP package revision (the exact .deb installed), tracked from the Symas apt repo",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^Makefile$/"
      ],
      "matchStrings": [
        "(?m)^ARG SYMAS_VERSION=(?<currentValue>\\S+)",
        "(?m)^SYMAS_VERSION\\s+\\?=\\s+(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "symas-openldap-server",
      "packageNameTemplate": "symas-openldap-server",
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://repo.symas.com/repo/deb/main/release26?suite=trixie&components=main&binaryArch=amd64",
      "versioningTemplate": "deb"
    },
    {
      "customType": "regex",
      "description": "Upstream OpenLDAP version (image tag / label), derived from the same Symas package",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^Makefile$/"
      ],
      "matchStrings": [
        "(?m)^ARG OPENLDAP_VERSION=(?<currentValue>\\S+)",
        "(?m)^OPENLDAP_VERSION \\?= (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "openldap",
      "packageNameTemplate": "symas-openldap-server",
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://repo.symas.com/repo/deb/main/release26?suite=trixie&components=main&binaryArch=amd64",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Group both OpenLDAP pins into one PR; not automerged — the build must pass with the new Symas version, and `make bump-openldap` keeps the two pins in sync.",
      "matchPackageNames": [
        "symas-openldap-server"
      ],
      "groupName": "openldap version",
      "automerge": false
    },
    {
      "description": "Track only the 2.6 LTS line.",
      "matchPackageNames": [
        "symas-openldap-server"
      ],
      "allowedVersions": "/^2\\.6\\./"
    },
    {
      "description": "Disable updates for debian:trixie-slim. The codename tag has no version to compare; the weekly Rebuild workflow picks up its rebuilds.",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "debian"
      ],
      "enabled": false
    }
  ]
}
