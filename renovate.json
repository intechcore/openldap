{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Lint and scan tool images in the Makefile, pinned by tag and digest",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+\\s+\\?=\\s+\\S+?:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ]
    },
    {
      "customType": "regex",
      "description": "Pinned Symas OpenLDAP package revision (the exact .deb installed), tracked from the Symas apt repo",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^Makefile$/"
      ],
      "matchStrings": [
        "(?m)^ARG SYMAS_VERSION=(?<currentValue>\\S+)",
        "(?m)^SYMAS_VERSION\\s+\\?=\\s+(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "symas-openldap-server",
      "packageNameTemplate": "symas-openldap-server",
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://repo.symas.com/repo/deb/main/release26?suite=trixie&components=main&binaryArch=amd64",
      "versioningTemplate": "deb"
    },
    {
      "customType": "regex",
      "description": "Upstream OpenLDAP version (image tag / label), derived from the same Symas package",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^Makefile$/"
      ],
      "matchStrings": [
        "(?m)^ARG OPENLDAP_VERSION=(?<currentValue>\\S+)",
        "(?m)^OPENLDAP_VERSION \\?= (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "openldap",
      "packageNameTemplate": "symas-openldap-server",
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://repo.symas.com/repo/deb/main/release26?suite=trixie&components=main&binaryArch=amd64",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update the image tag in the README quick start",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "# renovate: image=ghcr\\.io/intechcore/openldap\\n\\s*image: ghcr\\.io/intechcore/openldap:(?<currentValue>[\\d.]+-\\d+)"
      ],
      "depNameTemplate": "ghcr.io/intechcore/openldap",
      "datasourceTemplate": "docker"
    }
  ],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "itcsrvs",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Group both OpenLDAP pins into one PR; not automerged — the build must pass with the new Symas version, and `make bump-openldap` keeps the two pins in sync.",
      "matchPackageNames": [
        "symas-openldap-server"
      ],
      "groupName": "openldap version",
      "automerge": false
    },
    {
      "description": "Track only the 2.6 LTS line.",
      "matchPackageNames": [
        "symas-openldap-server"
      ],
      "allowedVersions": "/^2\\.6\\./"
    },
    {
      "description": "debian:trixie-slim is pinned by digest. Renovate updates the digest when Debian rebuilds the image under the same tag, and the weekly Rebuild then releases it. The codename tag itself stays.",
      "matchDatasources": ["docker"],
      "matchDepNames": ["debian"],
      "pinDigests": true
    },
    {
      "description": "Own image, private on ghcr.io (see hostRules). Every release publishes the exact build tag (2.6.15-2) next to the moving tag (2.6.15) and latest. Regex versioning tracks only the exact one and orders by the build number. Docker versioning would read -N as a compatibility tag and hide rebuilds.",
      "matchPackageNames": [
        "ghcr.io/intechcore/openldap"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    }
  ]
}
