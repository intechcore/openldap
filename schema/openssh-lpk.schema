# OpenSSH LPK (LDAP Public Key) schema.
#
# Stores users' SSH public keys in LDAP so sshd can fetch authorized keys
# centrally (AuthorizedKeysCommand with sss_ssh_authorizedkeys / openssh-ldap).
# ldapPublicKey is AUXILIARY — add it to an existing account (e.g. inetOrgPerson)
# and populate sshPublicKey. OID arc 1.3.6.1.4.1.24552 is OpenSSH's IANA PEN.
attributetype ( 1.3.6.1.4.1.24552.500.1.1.1.13 NAME 'sshPublicKey'
    DESC 'MANDATORY: OpenSSH Public key'
    EQUALITY octetStringMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.40 )

objectclass ( 1.3.6.1.4.1.24552.500.1.1.2.0 NAME 'ldapPublicKey' SUP top AUXILIARY
    DESC 'MANDATORY: OpenSSH LPK objectclass'
    MAY ( sshPublicKey $ uid ) )
