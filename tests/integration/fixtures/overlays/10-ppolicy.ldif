# Enable the ppolicy (password policy) overlay — the schema extension the
# intechcore directory relies on (account lockout, password history, the
# pwdAccountLockedTime enable/disable mechanism used by itc-ctrl).
#
# The mdb data backend is olcDatabase={1}mdb,cn=config (osixia-compatible index).
dn: cn=module{0},cn=config
changetype: modify
add: olcModuleLoad
olcModuleLoad: ppolicy

dn: olcOverlay=ppolicy,olcDatabase={1}mdb,cn=config
changetype: add
objectClass: olcOverlayConfig
objectClass: olcPPolicyConfig
olcOverlay: ppolicy
olcPPolicyDefault: cn=default,ou=policies,dc=example,dc=test
olcPPolicyHashCleartext: TRUE
