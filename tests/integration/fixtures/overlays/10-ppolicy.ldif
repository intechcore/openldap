# Enable the ppolicy (password policy) overlay — account lockout, password
# history, the pwdAccountLockedTime enable/disable mechanism used by itc-ctrl.
#
# The ppolicy module (and its pwdPolicy schema) is loaded by default, so only
# the overlay itself needs configuring here. The mdb data backend is
# olcDatabase={1}mdb,cn=config (osixia-compatible index).
dn: olcOverlay=ppolicy,olcDatabase={1}mdb,cn=config
changetype: add
objectClass: olcOverlayConfig
objectClass: olcPPolicyConfig
olcOverlay: ppolicy
olcPPolicyDefault: cn=default,ou=policies,dc=example,dc=test
olcPPolicyHashCleartext: TRUE
