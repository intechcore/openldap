# Anonymized, synthetic people — model the production schema (inetOrgPerson with
# cn-based RDN, displayName/givenName/sn/mail/preferredLanguage) without any real
# data. Cleartext userPassword values are hashed on add by the ppolicy overlay
# (olcPPolicyHashCleartext=TRUE); the shared test password is "Secret123".
dn: cn=asmith,ou=people,dc=example,dc=test
objectClass: inetOrgPerson
cn: asmith
displayName: Alice Smith
givenName: Alice
sn: Smith
mail: asmith@example.test
preferredLanguage: en
userPassword: Secret123

